{
  "name": "flash-cards-learn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint-fix": "biome check --write",
    "prepare": "husky",
    "test": "vitest run --reporter=verbose"
  },
  "lint-staged": {
    ".src/**/*.{ts,tsx,json,md}": [
      "biome format --write",
      "biome check"
    ]
  },
  "dependencies": {
    "atomic-router": "0.12.0",
    "atomic-router-react": "0.12.1",
    "clsx": "2.1.1",
    "effector": "23.4.4",
    "effector-react": "23.3.0",
    "history": "5.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "22.13.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.0.3",
    "@types/serviceworker": "0.0.120",
    "@vitejs/plugin-react": "5.1.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "radix-ui": "^1.4.3",
    "tailwindcss": "^4.1.16",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.3"
  }
}
